[Unit]
Description=Ratatoskr Extractor
Documentation=https://github.com/po4yka/ratatoskr-extractor/blob/main/deploy/README.md
After=network-online.target docker.service
Wants=network-online.target docker.service
StartLimitIntervalSec=0

[Service]
Type=exec
User=ratatoskr-extractor
Group=ratatoskr-extractor
EnvironmentFile=/etc/ratatoskr/extractor.conf
ExecStartPre=/usr/local/bin/ratatoskr-extractor check-config
ExecStart=/usr/local/bin/ratatoskr-extractor
Restart=always
RestartSec=10s
KillSignal=SIGTERM
TimeoutStopSec=35s

StandardOutput=append:/mnt/nvme/ratatoskr/logs/extractor.log
StandardError=append:/mnt/nvme/ratatoskr/logs/extractor.log

MemoryHigh=768M
MemoryMax=1G
CPUQuota=200%
TasksMax=256

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
ReadWritePaths=/mnt/nvme/ratatoskr/blobs/ratatoskr-extractor
ReadOnlyPaths=/etc/ratatoskr/extractor.nkey

[Install]
WantedBy=multi-user.target
