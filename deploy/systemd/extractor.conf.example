RATATOSKR__ADMIN__BIND=0.0.0.0:9467
RATATOSKR__BLOBS__ROOT=/mnt/nvme/ratatoskr/blobs/ratatoskr-extractor
RATATOSKR__DATABASE__URL=postgresql://ratatoskr_extractor:REPLACE_ME@127.0.0.1:5432/ratatoskr
RATATOSKR__DATABASE__MAX_CONNECTIONS=10
RATATOSKR__BUS__URL=nats://127.0.0.1:4222
RATATOSKR__BUS__NKEY_SEED_PATH=/etc/ratatoskr/extractor.nkey
RATATOSKR__BUS__DURABLE_NAME=ratatoskr_extractor_capture
RATATOSKR__PARSER__MAX_INPUT_BYTES=52428800
RATATOSKR__PARSER__MAX_DOM_NODES=250000
RATATOSKR__TELEMETRY__LOG_FORMAT=json
